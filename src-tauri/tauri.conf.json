{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "NexFlow ERP",
  "version": "1.3.0",
  "identifier": "br.com.voortz.nexflowerp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexFlow ERP | Gestão Comercial & PDV - Voortz",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Voortz",
    "copyright": "© 2026 Voortz Tecnologia. Todos os direitos reservados.",
    "category": "Business",
    "shortDescription": "Sistema de Gestão Comercial, PDV e Estoque Offline-First",
    "longDescription": "NexFlow ERP é uma solução comercial inteligente desenvolvida pela Voortz para controle de vendas, estoque, frente de caixa (PDV), CRM e sincronização em nuvem.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["PortugueseBR"]
      }
    }
  }
}
